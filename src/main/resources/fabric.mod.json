{
  "schemaVersion": 1,
  "id": "nimbus",
  "version": "${version}",
  "name": "Nimbus",
  "description": "Client and server optimization: per-type entity/block entity culling, async ray occlusion, far LOD, particle culling and per-type toggles, client tick LOD, world resolution scaling with CAS sharpening, adaptive quality, borderless fullscreen, CPU render-ahead limit, extended graphics settings with Sacrifice presets.",
  "authors": [
    "qateralong"
  ],
  "license": "All Rights Reserved",
  "icon": "assets/nimbus/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.qateralong.nimbus.common.NimbusCommon"
    ],
    "client": [
      "com.qateralong.nimbus.Nimbus"
    ],
    "modmenu": [
      "com.qateralong.nimbus.ModMenu"
    ],
    "sodium:config_api_user": [
      "com.qateralong.nimbus.NimbusSodiumConfig"
    ]
  },
  "mixins": [
    {
      "config": "nimbus.mixins.json",
      "environment": "client"
    },
    "nimbus.common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "breaks": {
    "entityculling": "*"
  },
  "accessWidener": "nimbus.accesswidener"
}
